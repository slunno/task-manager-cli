# Copie para .env.supabase na raiz. Esse arquivo local e ignorado pelo Git.
# A senha fica somente nesta variavel, separada da URL JDBC.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_USER=postgres
SUPABASE_DB_JDBC_URL=jdbc:postgresql://db.evsmgbziifqbyahvcwsc.supabase.co:5432/postgres?sslmode=require&currentSchema=helpdesk
SUPABASE_DB_POOL_SIZE=5

# Se sua rede nao tiver IPv6, copie o JDBC do Session pooler (porta 5432)
# em Connect no painel Supabase e substitua URL e usuario acima.
# Mantenha sslmode=require e currentSchema=helpdesk. Nao use a porta 6543.

# Ambiente local: login dev apenas em 127.0.0.1; SMTP local/MailHog opcional.
PORT=8080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=false
SMTP_STARTTLS_REQUIRED=false
HELPDESK_PORTAL_URL=http://localhost:5173
HELPDESK_STORAGE_MODE=local
HELPDESK_STORAGE_LOCAL_DIRECTORY=./data/anexos
# Suspenso por padrao neste banco remoto ate a politica ser aprovada.
HELPDESK_RETENTION_ENABLED=false
# Login com senha: ative scripts/iniciar-supabase.ps1 -LoginSupabase.
# A chave publicável é diferente da chave secreta usada para administrar contas.
SUPABASE_URL=https://evsmgbziifqbyahvcwsc.supabase.co
SUPABASE_PUBLISHABLE_KEY=
