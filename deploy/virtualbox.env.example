# Copie para .env.virtualbox na raiz do projeto DENTRO DO UBUNTU.
# Substitua os valores PREENCHER. Sem aspas, sem espaço após =.
# env_file raw preserva caracteres como $ nas senhas.
SUPABASE_DB_JDBC_URL=jdbc:postgresql://PREENCHER_HOST_SESSION_POOLER:5432/postgres?sslmode=require&currentSchema=helpdesk
SUPABASE_DB_USER=postgres.evsmgbziifqbyahvcwsc
SUPABASE_DB_PASSWORD=PREENCHER_SENHA_ATUAL_DO_BANCO
SUPABASE_DB_POOL_SIZE=5
SUPABASE_URL=https://evsmgbziifqbyahvcwsc.supabase.co
SUPABASE_PUBLISHABLE_KEY=PREENCHER_CHAVE_PUBLICAVEL

HELPDESK_S3_ENDPOINT=https://PREENCHER_ACCOUNT_ID.r2.cloudflarestorage.com
HELPDESK_S3_ACCESS_KEY=PREENCHER_ACCESS_KEY_ID
HELPDESK_S3_SECRET_KEY=PREENCHER_SECRET_ACCESS_KEY
HELPDESK_S3_BUCKET=lumeo-anexos

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=PREENCHER_LOGIN_SMTP
SMTP_PASSWORD=PREENCHER_CHAVE_SMTP
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
HELPDESK_MAIL_FROM=PREENCHER_EMAIL_REMETENTE_VERIFICADO

# Valor inicial apenas para subir os contêineres e obter a URL do túnel.
# Atualize com a URL HTTPS real ANTES de criar chamados e testar e-mails.
HELPDESK_PORTAL_URL=https://example.invalid
HELPDESK_STORAGE_MODE=s3
HELPDESK_RETENTION_ENABLED=false
