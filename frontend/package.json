{
  "name": "helpdesk-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "api:generate": "openapi-typescript openapi.json -o src/api/generated.ts && prettier --write src/api/generated.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
