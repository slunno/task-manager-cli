{
  "openapi": "3.1.0",
  "info": { "title": "OpenAPI definition", "version": "v0" },
  "paths": {
    "/api/v1/chamados": {
      "post": {
        "tags": ["chamado-controller"],
        "operationId": "criar",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CriarChamadoRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Chamado criado",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ChamadoResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/dev/login": {
      "post": {
        "tags": ["dev-login-controller"],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/UsuarioResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": ["usuario-controller"],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/UsuarioResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chamados/{id}": {
      "get": {
        "tags": ["chamado-controller"],
        "operationId": "detalhe",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ChamadoResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chamados/meus": {
      "get": {
        "tags": ["chamado-controller"],
        "operationId": "meus",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 20 }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "default": "criadoEm,desc" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaResponseChamadoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categorias": {
      "get": {
        "tags": ["categoria-controller"],
        "operationId": "listar",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CategoriaResponse" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": ["auth-controller"],
        "operationId": "csrf",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/CsrfResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "tags": ["auth-controller"],
        "operationId": "config",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ConfigResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CriarChamadoRequest": {
        "type": "object",
        "properties": {
          "titulo": { "type": "string", "maxLength": 200, "minLength": 0 },
          "descricao": { "type": "string", "maxLength": 10000, "minLength": 0 },
          "categoriaId": { "type": "integer", "format": "int64" },
          "prioridadeSugerida": {
            "type": "string",
            "enum": ["BAIXA", "MEDIA", "ALTA", "CRITICA"]
          },
          "solicitanteId": { "type": "integer", "format": "int64" }
        },
        "required": ["categoriaId", "descricao", "titulo"]
      },
      "ChamadoResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "numero": { "type": "string" },
          "titulo": { "type": "string" },
          "descricao": { "type": "string" },
          "solicitanteId": { "type": "integer", "format": "int64" },
          "abertoPorId": { "type": ["integer", "null"], "format": "int64" },
          "categoriaId": { "type": "integer", "format": "int64" },
          "prioridade": {
            "type": "string",
            "enum": ["BAIXA", "MEDIA", "ALTA", "CRITICA"]
          },
          "prioridadeSugerida": {
            "type": ["string", "null"],
            "enum": ["BAIXA", "MEDIA", "ALTA", "CRITICA"]
          },
          "status": {
            "type": "string",
            "enum": [
              "ABERTO",
              "EM_ATENDIMENTO",
              "AGUARDANDO_USUARIO",
              "RESOLVIDO",
              "FECHADO"
            ]
          },
          "criadoEm": { "type": "string", "format": "date-time" },
          "atualizadoEm": { "type": "string", "format": "date-time" },
          "version": { "type": "integer", "format": "int64" }
        },
        "required": [
          "abertoPorId",
          "atualizadoEm",
          "categoriaId",
          "criadoEm",
          "descricao",
          "id",
          "numero",
          "prioridade",
          "prioridadeSugerida",
          "solicitanteId",
          "status",
          "titulo",
          "version"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "minLength": 1 },
          "nome": { "type": "string", "maxLength": 180, "minLength": 0 }
        },
        "required": ["email", "nome"]
      },
      "UsuarioResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "nome": { "type": "string" },
          "email": { "type": "string" },
          "perfil": {
            "type": "string",
            "enum": ["FUNCIONARIO", "TI_AGENTE", "TI_ADMIN"]
          }
        }
      },
      "PaginaResponseChamadoResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChamadoResponse" }
          },
          "page": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" }
        },
        "required": ["content", "page", "size", "totalElements", "totalPages"]
      },
      "CategoriaResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "nome": { "type": "string" }
        },
        "required": ["id", "nome"]
      },
      "CsrfResponse": {
        "type": "object",
        "properties": { "token": { "type": "string" } }
      },
      "ConfigResponse": {
        "type": "object",
        "properties": {
          "modo": { "type": "string" },
          "urlLogin": { "type": "string" }
        }
      }
    }
  }
}
