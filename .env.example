# Copie para um arquivo de ambiente local e defina valores próprios.
HELPDESK_DB_USER=helpdesk
HELPDESK_DB_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
HELPDESK_S3_BUCKET=helpdesk-anexos

# Backend local fora do Compose
DATABASE_URL=jdbc:postgresql://localhost:5432/helpdesk
DATABASE_USER=helpdesk
DATABASE_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
SPRING_PROFILES_ACTIVE=dev

# E1: registrar um cliente OIDC corporativo antes de ativar o login.
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
OIDC_ALLOWED_EMAIL_DOMAIN=empresa.com

# Para S3 em produção: bucket privado criado previamente.
HELPDESK_STORAGE_MODE=local
HELPDESK_STORAGE_LOCAL_DIRECTORY=./data/anexos
HELPDESK_S3_ENDPOINT=http://localhost:9000
HELPDESK_S3_ACCESS_KEY=
HELPDESK_S3_SECRET_KEY=


# Notificações e conclusão
HELPDESK_MAIL_FROM=helpdesk@localhost
HELPDESK_PORTAL_URL=http://localhost:3000
HELPDESK_REOPEN_DAYS=7
HELPDESK_AUTOCLOSE_DAYS=3
